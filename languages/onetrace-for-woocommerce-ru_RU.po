#. Plugin Name of the plugin
#: onetrace-woocommerce.php
msgid "OneTrace for WooCommerce"
msgstr "OneTrace для WooCommerce"

#. Plugin URI of the plugin
#: onetrace-woocommerce.php
msgid "https://wordpress.org/plugins/onetrace-for-woocommerce/"
msgstr ""

#. Author of the plugin
#: onetrace-woocommerce.php
msgid "OneTrace.pro"
msgstr "OneTrace.pro"

#. Author URI of the plugin
#: onetrace-woocommerce.php
msgid "https://onetrace.pro"
msgstr "https://onetrace.pro"

#. translators: 1: folder of the active copy, 2: folder of the inactive copy
#: onetrace-woocommerce.php:35
#, php-format
msgid "OneTrace for WooCommerce is installed twice: the copy in the %1$s folder works, the copy in the %2$s folder is not loaded. Deactivate and delete the copy in %2$s — settings stay."
msgstr "OneTrace для WooCommerce установлен дважды: работает копия в папке %1$s, копия в папке %2$s не загружается. Отключите и удалите копию в %2$s — настройки сохранятся."

#: src/Admin.php:45
#: src/Admin.php:237
msgid "Settings"
msgstr "Настройки"

#: src/Admin.php:60
msgid "Set in wp-config.php."
msgstr "Задано в wp-config.php."

#: src/Admin.php:73
msgid "Connection"
msgstr "Подключение"

#: src/Admin.php:73
msgid "Keys are in the \"API keys\" section of your OneTrace project."
msgstr "Ключи — в разделе «Ключи API» вашего проекта OneTrace."

#: src/Admin.php:74
msgid "Platform address"
msgstr "Адрес платформы"

#: src/Admin.php:74
msgid "The address you open the platform at: the domain of your brand."
msgstr "Адрес, по которому вы открываете платформу: домен вашего бренда."

#: src/Admin.php:75
#: src/Admin.php:191
msgid "Write key"
msgstr "Ключ записи"

#: src/Admin.php:75
msgid "For the tracker on the storefront."
msgstr "Для трекера на витрине."

#: src/Admin.php:76
#: src/Admin.php:191
msgid "Secret key"
msgstr "Секретный ключ"

#: src/Admin.php:76
msgid "For orders, customers and the catalog; needs the products.write permission."
msgstr "Для заказов, покупателей и каталога; нужно право products.write."

#: src/Admin.php:79
msgid "What to send"
msgstr "Что передавать"

#: src/Admin.php:80
msgid "Tracker"
msgstr "Трекер"

#: src/Admin.php:80
msgid "Page and product views on the storefront"
msgstr "Просмотры страниц и товаров на витрине"

#: src/Admin.php:81
msgid "Cookie consent"
msgstr "Согласие на cookie"

#: src/Admin.php:81
msgid "Load the tracker after the visitor agrees to statistics cookies (with a consent plugin that supports the WP Consent API)"
msgstr "Загружать трекер после согласия посетителя на статистические cookie (с плагином согласия, который поддерживает WP Consent API)"

#: src/Admin.php:82
msgid "Orders"
msgstr "Заказы"

#: src/Admin.php:82
msgid "Placed, paid, cancelled and refunded orders with the customer data"
msgstr "Оформленные, оплаченные, отменённые заказы и возвраты с данными покупателя"

#: src/Admin.php:83
msgid "Cart"
msgstr "Корзина"

#: src/Admin.php:83
msgid "Adding to and removing from the cart, opening the checkout — for abandoned cart journeys"
msgstr "Добавление в корзину и удаление из неё, переход к оформлению — для цепочек брошенной корзины"

#: src/Admin.php:85
msgid "Product catalog"
msgstr "Каталог товаров"

#: src/Admin.php:86
msgid "Product id"
msgstr "ID товара"

#: src/Admin.php:86
msgid "Post ID"
msgstr "ID записи"

#: src/Admin.php:86
msgid "SKU (the post ID for products without a SKU)"
msgstr "Артикул (ID записи, если артикула нет)"

#: src/Admin.php:86
msgid "Choose SKU if your OneTrace project already has the catalog and history under SKUs, e.g. after moving from another platform."
msgstr "Выберите артикул, если каталог и история проекта OneTrace уже ведутся по артикулам, например после переезда с другой платформы."

#: src/Admin.php:89
msgid "Newsletter consent"
msgstr "Согласие на рассылку"

#: src/Admin.php:89
msgid "A checkbox subscribes the customer to marketing emails in OneTrace. Without it no consent is sent."
msgstr "Галочка подписывает покупателя на рекламные письма в OneTrace. Без неё согласие не передаётся."

#: src/Admin.php:90
msgid "Checkout"
msgstr "Оформление заказа"

#: src/Admin.php:90
msgid "Checkbox at checkout (classic and block)"
msgstr "Галочка при оформлении заказа (классическом и блочном)"

#: src/Admin.php:91
msgid "Registration"
msgstr "Регистрация"

#: src/Admin.php:91
msgid "Checkbox in the registration form"
msgstr "Галочка в форме регистрации"

#: src/Admin.php:92
msgid "Account"
msgstr "Личный кабинет"

#: src/Admin.php:92
msgid "Subscribe and unsubscribe on the account details page"
msgstr "Подписка и отписка на странице данных аккаунта"

#: src/Admin.php:93
msgid "Checkbox text"
msgstr "Текст галочки"

#: src/Admin.php:93
#: src/Settings.php:92
msgid "Send me news and special offers by email"
msgstr "Присылать новости и специальные предложения по email"

#: src/Admin.php:94
msgid "Subscription topic"
msgstr "Тема подписки"

#: src/Admin.php:94
msgid "Empty — the whole email channel."
msgstr "Пусто — весь канал email."

#: src/Admin.php:97
msgid "Recommendations, search and Web Push"
msgstr "Рекомендации, поиск и Web Push"

#: src/Admin.php:97
msgid "Widget ids are in the \"Site → Widgets\" section of the platform. Anywhere else use the [onetrace_widget id=\"…\"] shortcode."
msgstr "Идентификаторы виджетов — в разделе «Сайт → Виджеты» платформы. В любом другом месте используйте шорткод [onetrace_widget id=\"…\"]."

#: src/Admin.php:98
msgid "Widget on the product page"
msgstr "Виджет на странице товара"

#: src/Admin.php:99
msgid "Widget in the cart"
msgstr "Виджет в корзине"

#: src/Admin.php:100
msgid "Web Push"
msgstr "Web Push"

#: src/Admin.php:100
msgid "Serve /cdp-sw.js from the store root; put the [onetrace_push_button] shortcode where visitors subscribe"
msgstr "Отдавать /cdp-sw.js с корня магазина; шорткод [onetrace_push_button] поставьте там, где посетители подписываются"

#: src/Admin.php:101
msgid "Product search"
msgstr "Поиск по товарам"

#: src/Admin.php:101
msgid "Results of the store search and suggestions while typing come from OneTrace (the plan of the project must include product search); on an error — the usual WordPress search"
msgstr "Результаты поиска магазина и подсказки при вводе — из OneTrace (поиск по товарам должен быть в тарифе проекта); при ошибке — обычный поиск WordPress"

#: src/Admin.php:105
msgid "Loyalty program"
msgstr "Программа лояльности"

#: src/Admin.php:105
msgid "The program is set up in the \"Loyalty\" section of the platform. Signed-in customers pay for part of the order with points in the cart and at checkout and see their points in My account → Bonus points."
msgstr "Программа настраивается в разделе «Лояльность» платформы. Вошедшие покупатели оплачивают часть заказа баллами в корзине и при оформлении и видят баллы в «Мой аккаунт → Бонусные баллы»."

#: src/Admin.php:106
#: src/LoyaltyAccount.php:73
#: src/LoyaltyBlocks.php:78
#: src/LoyaltyCart.php:52
#: src/LoyaltyCart.php:53
msgid "Bonus points"
msgstr "Бонусные баллы"

#: src/Admin.php:106
msgid "Show the balance and use points in the cart and at checkout (the secret key needs the loyalty.read and loyalty.write permissions)"
msgstr "Показывать баланс и списывать баллы в корзине и при оформлении (секретному ключу нужны права loyalty.read и loyalty.write)"

#: src/Admin.php:126
msgid "Saved — enter a new key to replace it"
msgstr "Сохранён — введите новый ключ, чтобы заменить"

#. translators: %s: project name
#: src/Admin.php:182
#, php-format
msgid "Write key: project \"%s\"."
msgstr "Ключ записи: проект «%s»."

#. translators: %s: project name
#: src/Admin.php:184
#, php-format
msgid "Secret key: project \"%s\"."
msgstr "Секретный ключ: проект «%s»."

#: src/Admin.php:186
msgid "The key has no products.write permission: the catalog will not be uploaded."
msgstr "У ключа нет права products.write: каталог не будет выгружаться."

#: src/Admin.php:187
msgid "The key has no loyalty.read and loyalty.write permissions: bonus points will not work."
msgstr "У ключа нет прав loyalty.read и loyalty.write: бонусные баллы работать не будут."

#: src/Admin.php:196
msgid "Enter the platform address and the keys first."
msgstr "Сначала укажите адрес платформы и ключи."

#: src/Admin.php:213
msgid "The catalog upload has started; it runs in the background."
msgstr "Выгрузка каталога началась, она идёт в фоне."

#: src/Admin.php:235
msgid "OneTrace: sending is paused because the platform rejected the key. Check the keys and save the settings."
msgstr "OneTrace: отправка приостановлена — платформа отклонила ключ. Проверьте ключи и сохраните настройки."

