{
    "name": "onetracepro/onetrace-woocommerce",
    "description": "WooCommerce plugin for the OneTrace.pro customer data platform: server-side orders, customers and consents, the website tracker, product catalog sync, recommendation widgets and Web Push.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "keywords": ["onetrace", "woocommerce", "wordpress", "cdp", "customer data platform", "ecommerce", "marketing automation", "recommendations", "abandoned cart"],
    "homepage": "https://onetrace.pro",
    "support": {
        "issues": "https://github.com/OneTracePro/onetrace-woocommerce/issues",
        "source": "https://github.com/OneTracePro/onetrace-woocommerce"
    },
    "require": {
        "php": "^7.4 || ^8.0",
        "onetracepro/onetrace-php": "^1.4"
    },
    "require-dev": {
        "justinrainbow/json-schema": "^6.0",
        "php-stubs/woocommerce-stubs": "^9.0 || ^10.0 || ^11.0",
        "php-stubs/wp-cli-stubs": "^2.11",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^9.6",
        "szepeviktor/phpstan-wordpress": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "OneTrace\\WooCommerce\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OneTrace\\WooCommerce\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "7.4.33"
        },
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": false
        }
    }
}
